# Copy this file to prod.env (gitignored) and fill in real values.
# TEST_USER/TEST_PASSWORD must be a throwaway DemoBlaze account created via
# the site's own Signup form -- DemoBlaze has no account-provisioning API,
# so this is a fixed, shared, read-only-use test account (see README).
BASE_URL=https://www.demoblaze.com
API_BASE_URL=https://api.demoblaze.com
TEST_USER=
TEST_PASSWORD=
