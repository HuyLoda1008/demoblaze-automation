# Template only -- never commit a filled-in copy of this file.
#
# Create the real secret imperatively instead of applying a manifest, so
# credentials never touch a YAML file on disk:
#
#   kubectl create secret generic demoblaze-test-credentials \
#     --namespace <namespace> \
#     --from-literal=TEST_USER='...' \
#     --from-literal=TEST_PASSWORD='...'
#
# This file exists only to document the two keys the CronJob expects.
apiVersion: v1
kind: Secret
metadata:
  name: demoblaze-test-credentials
type: Opaque
stringData:
  TEST_USER: REPLACE_ME
  TEST_PASSWORD: REPLACE_ME
