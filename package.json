{
  "name": "demoblaze-automation",
  "version": "1.0.0",
  "private": true,
  "description": "E2E automation framework (Playwright + TypeScript) for DemoBlaze Login and Cart flows.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test tests/api",
    "test:perf": "playwright test tests/performance",
    "test:a11y": "playwright test tests/accessibility",
    "test:unit": "playwright test tests/unit --project=chromium",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/html",
    "gen:testcases": "tsx test-cases/generate-xlsx.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "demo": "tsx demo/record-demo.ts"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "qa-automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
